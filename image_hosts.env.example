# 图床配置示例 (image_hosts.env)
# 生产环境部署时请复制为 data/image_hosts.env 并填入实际 Token/Key，切勿提交凭据入库

# Lsky Pro 图床配置 (如 CrabPT / 自建 Lsky)
LSKY_API_URL=https://img.crabpt.vip/api/v1
LSKY_TOKEN=
LSKY_EMAIL=
LSKY_PASSWORD=
LSKY_MAX_BYTES=5242880

# PicGo / 车库图床
PICGO_API_URL=
PICGO_API_KEY=
PICGO_MAX_BYTES=10485760

# PTer 专属图床
PTER_IMG_UPLOAD_URL=
PTER_IMG_API_KEY=
