# 复制这个文件为 .env，并填入真实值。.env 不要提交到 git（记得加进 .gitignore）。

# ---- qBittorrent ----
# 单容器 + network_mode: host（见 docker-compose.yml 的 x-common），容器直接共享宿主机网络栈，
# 所以填「宿主机自己访问 qB」的真实地址：
#   如果 qBittorrent 和 Docker 跑在同一台机器上，用 127.0.0.1；
#   如果 qBittorrent 在局域网里的另一台设备上，用那台设备的局域网 IP（比如 192.168.0.7）。
# ★ 别写 host.docker.internal —— host 网络下没有这条 DNS 记录（ERRATA.md 的 ERR-DOCKER-04）。
# ★ 端口填 NAS 上 qB 实际的 WebUI 端口（本项目是 3020）。
# ★ 这一行要**显式写**：compose 的兜底 `${QB_HOST:-http://127.0.0.1:3020}` 恰好等于正确值，
#   漏了不会报错，但地址就不再由 .env 钉住 —— 谁动一下兜底就静默换。
# ★ 旧的 QB_HOST_SCAN / QB_HOST_PUBLISH 是双容器时代的键，现已无任何代码读取；
#   旧 .env 里留着不影响运行，可删（ERRATA.md 的 ERR-ENV-01）。
QB_HOST=http://127.0.0.1:3020
QB_USER=admin
QB_PASS=changeme

# ---- Musopia 站点 ----
MUSOPIA_URL=https://www.example.com
# 从浏览器登录后的 Cookie 里复制 c_secure_pass 的值（不要带 "c_secure_pass=" 前缀之外的其它 Cookie）
MUSOPIA_COOKIE=c_secure_pass=changeme
MUSOPIA_PASSKEY=changeme

# ---- PicGo 图床 ----
PICGO_API_KEY=changeme

# ---- Lsky Pro 图床（★ 蟹黄堡专用）----
# ★★ 为什么是两个图床：乌托邦用 PicGo（上面那个），蟹黄堡要用**它自己的**图链。
#    用户 2026-09-25 明确要求，且**不能混用**（拿 picgo 的链去发蟹黄堡是跨站引用）。
#    ⇒ 封面按站各存一份，见 db.site_publish 的 cover_url。
# ★ token 从哪来（★★ 2026-09-27 改：**推荐用账号密码自动换**，见下面 LSKY_EMAIL）：
#    登录 https://img.crabpt.vip → 「接口」页 → 生成 Token。
#    请求头是 `Authorization: Bearer <token>`（★ 与 PicGo 的 X-API-Key 不同）。
# ★★★ 为什么**不推荐**手工往 LSKY_TOKEN 里填（这是实测踩出来的）：
#    站点文档原话是「当前版本接口采用『HTTP 基本验证』的方式验证授权，
#    **获取到 token 后**，通过设置请求 header 标头来验证请求(Bearer Token)」
#    —— 那句话里有**两个**动作。手工复制只覆盖了第二个，而**人眼分不出
#    "token" 与"浏览器 Cookie 串"**（两者都是长随机串）。实测有一次填进去的
#    是 `XSRF-TOKEN=...; crabpt_session=...`（714 字符）⇒ 打过去 **HTTP 401**，
#    且因为 upload_to_lsky() 只在**真发布那一刻**才调它，这个错**潜伏了两天**。
# ★★ 所以：**优先配 LSKY_EMAIL / LSKY_PASSWORD**，token 由程序自己换并缓存到
#    `${DATA_DIR}/lsky_token.json`（缓存是为了省接口配额 —— 文档里 429 = 超出配额）。
#    LSKY_TOKEN 保留为**兜底**（程序换不到时才用它），不再是首选。
# ★★ 这几个键**必须手工加到 NAS 的 .env**：deploy.sh 的白名单不含 .env
#    （那里面是生产独有的真凭据），照 ERR-ENV-02。
# ★ 没配的后果是**明确**的：upload_to_lsky() 打印原因并返回空 ⇒
#    蟹黄堡那条**不发布会**（而不是发一条没封面的）。
# ★ 改完怎么验（**便宜、不发布、不扣配额**）：
#      docker exec -w /app opencd2musopia python assets.py
#   要真换一次 token（**会扣一次接口配额**）：加 `--online`。
LSKY_API_URL=https://img.crabpt.vip/api/v1
# ★ 推荐路径：账号密码（程序自己换 token）
LSKY_EMAIL=
LSKY_PASSWORD=
# ★ 兜底路径：手工从「接口」页复制的 token（留空即可，除非换 token 走不通）
LSKY_TOKEN=
# ★ 可选：token 缓存路径。留空 = `${DATA_DIR}/lsky_token.json`
# LSKY_TOKEN_FILE=

# ---- 分类名（一般不用改） ----
OPENCD_CATEGORY=opencd
PUBLISH_CATEGORY=Musopia
# ★ 蟹黄堡（第二发布站）在 qB 里的分类 —— **与乌托邦分开**，便于"哪条种子属于哪一站"
#   在 qB 里一眼可辨、也便于按站统计（2026-10-03 接线到 publish.py::readd_to_qb_crabpt）。
# ★★ 只影响**此后新加**的种子；qB 里**已有**的蟹黄堡种子仍挂在 PUBLISH_CATEGORY
#   名下，**不会自动迁移**。
# ★ 需在 qB 里**先建好**这个分类（qB 不自动创建）；留空/指向不存在的分类
#   ⇒ 种子仍入库但分类为空。若不想分，把它设成与 PUBLISH_CATEGORY 同值即可。
CRABPT_PUBLISH_CATEGORY=CrabPT

# ---- ★ 延迟回加 qB（延迟做种，2026-10-03 加）----
# ★ 干什么：种子**发布成功后不立即加进 qB**，等这么多分钟再加 ⇒ qB 收到后自己
#   校验、自己做种。目的：别人 RSS 到这条种子有时差，延迟一会儿让**尽量多的人
#   同时开始下载**（=扩散更广）。★ 15 是暂定值，**没实测**哪种最合适。
# ★★ 默认 **0 = 关闭**（= 发布后立即回加，老行为）。要开**显式**设 >0 分钟。
# ★ 实现：publish.py 把待回加写进 `/data/readd_queue.json`（含 .torrent 字节），
#   daemon.py 主循环每 SCHED_TICK(30s) 扫一次，到点才 add。详见 readd_queue.py。
# ★★★ 已知干扰（2026-10-03，用户决定先忽略）：延迟窗口内，NAS 上别的容器
#   （reseed/iyuu 辅种那套）若看到站点有新种、自动辅种，可能**抢先**把它加进 qB
#   ⇒ 延迟失效。本项目**不拦不检测**，仅此记录，供排查"延迟没生效"时第一顺位怀疑。
SEED_DELAY_MIN=0

# ---- OpenCD（皇后）转载流水线 —— 第二阶段的凭据 ----
# ★ 这是**皇后的** Cookie，跟上面 MUSOPIA_COOKIE 是两个站、两个账号，别混。
# ★ 用途：crawl.py 抓皇后详情页。缺了它 crawl 会在 check_login() 前直接退出（退出码 2）。
# ★★ 从浏览器登录皇后后，从 Cookie 里复制**整个** Cookie 串（含 c_secure_pass 那一段）。
#    与 MUSOPIA_COOKIE 不同 —— 那个只取 c_secure_pass，皇后这边给整串更省事。
# ★★ 配好之前**不要**把 crawl 接进 daemon 调度：否则每轮
#    就因缺 Cookie 白跑一轮，而且那是配置缺失、退避救不了。
# ★ 这一行**不在 .env.example 之外的地方维护** ——
#    .env 不在 deploy.sh 白名单（ERR-ENV-02），所以加了这里之后
#    **还要在 NAS 上手工把它填进那份 .env**。
#   ★ 2026-09-22：cookie 失效**不会静默** —— crawl 探活失败 ⇒ 退出码 1 ⇒
#     daemon 记连续失败并指数退避；且 daemon_state.json 里 crawl.last_ok=false，
#     每小时巡检会报出来。★「发邮件告警」并入每日邮件待办，
#     本期**不实现 SMTP**（避免引入新凭据管理）。
OPENCD_COOKIE=changeme
# 皇后站点地址（有兜底 https://open.cd，一般不用改）
OPENCD_URL=https://open.cd
# ★ 抓取层的频率控制（三道闸门，见 opencd_rate.py）
#   ★ 「省请求靠抓过就跳，不是把间隔调大」—— 这几个值别乱调大
#   ★★ 量纲提醒：下面三个**全是「请求」量纲**，没有「种子」概念。
#      ✅ 2026-09-23 量纲订正：**一条种子 = 1 个请求**（只抓详情页，抓过的还跳过）。
#         ⇒ OPENCD_MAX_PER_DAY=50 现在约等于 **50 个页面/天**。
#         ★ 旧的「一种子 ≈ 2~3 请求 ⇒ 约 17~25 种子/天」是**名称搜索时代**的比例，
#           随那条路一起作废（按名字搜 1 次 + 验候选 1~5 次）。照旧比例估产能会
#           **低估一倍**（ERR-META-04：改了行为却不改文档）。
#   ✅ 2026-09-22：跨轮持久**已启用** —— 计数落在 data.db 的 opencd_quota 表里，
#      所以「每日 50」现在是**真的每日 50**（不再是"每轮 20"）。
#      ⚠️ 但量纲仍是**请求**（不是种子）—— 想按种子卡要在入库那步记 kind='seed'，
#         见 opencd_rate.py 模块头「已知缺口」①（**别读成已解决**）。
#   ★ 这三行的兜底值 = 用户 2026-09-19 要的值 ⇒ **NAS 上不填也正确**；
#     填进来是为了「由 .env 钉住」，而不是靠代码兜底（谁动一下兜底就静默换）。
#     注意 .env 不在 deploy.sh 白名单（ERR-ENV-02），所以要 NAS 上手工填。
OPENCD_MAX_PER_ROUND=20      # 每轮最多几个请求（防某天突然涌入几百个）
OPENCD_MIN_INTERVAL=120      # 两次请求最小间隔（秒）— 只防瞬时连击，不是节奏控制
OPENCD_MAX_PER_DAY=50        # 当日请求上限（硬刹车）— ★ 请求量纲，非种子数
# OPENCD_RAW_DIR=/data/raw_html  # 详情页落盘目录（兜底 = ${DATA_DIR}/raw_html）。
#                                # ★ 落盘是刻意的：解析层永不重复请求，源站改版时重放即可
# ★ 原来的 OPENCD_INTERVAL（阶段周期）已删，改名 CRAWL_INTERVAL（见下面"crawl 阶段"）。

# ---- 状态/产物存储目录（容器内路径，compose 里 bind mount 到宿主机目录 `${STATE_DIR}`，一般不用改） ----
DATA_DIR=/data

# ==================== 容器化自动运行（daemon.py 调度器） ====================

# 总开关：true = 只预览不改站点（首次部署强烈建议先这样跑一轮看日志）
DRY_RUN=false

# 各阶段开关
ENABLE_SCAN=true
ENABLE_PUBLISH=true
ENABLE_SYNC=true
ENABLE_COVERS=true
ENABLE_EDIT=true

# ---- ★★ 自动发布的第二把钥匙（2026-09-24 新增） ----
# 为什么要有它：发布是本项目**唯一不可逆**的动作（站点上没有"批量撤回"）。
# 改动前，"自动发"和"人发的"**共用同一条路径** —— 只要 ENABLE_PUBLISH=true
# 且 DRY_RUN=false，daemon 就会无人值守地把整个队列发出去，人不在回路里。
# ⇒ 现在把钥匙**分开放两处**：
#     · ENABLE_PUBLISH  = 容器的**长期**开关（在 .env 里，改一次一直有效）
#     · PUBLISH_I_AM_HERE = 自动路径**每次执行**都要成立的第二把钥匙
# ★ 判据：这个变量**只在无人值守路径**（`publish.py --auto`，即 daemon 调的
#   那条）上被校验。人在终端前手敲 `python publish.py` **不受影响**。
# ★★ 不填的后果：daemon 的 publish 阶段**每轮都拒绝发布**并以退出码 3 结束
#   ⇒ 触发指数退避 ⇒ **不会**静默地什么都不做（日志里会明写"还没配"）。
#   ★ 这是**刻意**的失败方向：钥匙没配 = 不发。
# ★ 值就是下面这个字面量（连字符不用转义 —— compose 只展开 .env 的**值**，
#   不展开键名）。改了值的唯一后果是"不发"，不会污染任何数据。
# ★ 与 ENABLE_PUBLISH 的关系：**两个都为真**才会自动发。
#   ⇒ 想彻底停掉自动发布，改 ENABLE_PUBLISH=false 更干净（阶段压根不排）。
PUBLISH_I_AM_HERE=i-am-here

# ★★ crawl 阶段（按已知 tid 抓皇后详情页，补 mapped_json）—— 2026-09-23 改指向。
#    ★★ 它以前跑的是 `crawl.py --from-qb`（扫 qB → **按种子名称搜索**皇后 → 验候选
#      infohash → 抓页面）。那条路**已整条删除**（用户决定），三个理由都是实测：
#        ① 一条 2~3 请求（搜索 1 + 验候选 1~5），而 OPENCD_MAX_PER_DAY 只有 50；
#        ② 会搜错 —— 搜「齐秦 - 我拿什么爱你」返回 2 条（FLAC 分轨 / WAV 整轨），
#           名字几乎相同，取第一条就发错种子；
#        ③ 抓了也发不出去 —— 它传 qb_seed_days=None ⇒ 每行落 NOT_SEEDED ⇒
#           卡在发布队列闸门①（status='SUCCESS'）⇒ 等于白抓。
#      ⇒ 本阶段现在跑 `topup_opencd_fields.py`（从库里选"有 tid 但 mapped_json 空"
#        的行，逐条抓详情页）。★ **抓页面这件事没有取消** —— 转载规则 / 标签 /
#        媒介 / 製作組 / 艺术家 / 年份**只存在于页面上**，VT 只给页面编号。
#        闸门③④（db.PENDING_PUBLISH_WHERE）正是因此存在。
#    ★ 为什么默认**关**：它是**唯一会主动出网访问别人站点**的阶段。
#      默认关 = 升级镜像**不改变对外行为**，要开必须显式加这一行。安全默认。
#      ★ 2026-09-23 用户："先不开，手动看看效果" ⇒ 保持 false。
#    ★ 为什么它**不会产生任何新发布**：闸门③④ 要求 transfer_rule='ALLOW'，
#      而 crawl 只补内容、不改 status —— 发布仍要过 publish 阶段那一整套闸门。
ENABLE_CRAWL=false
# ★★ dry-run 是**专用**开关，与上面的 DRY_RUN **无关**（两个站、两个风险面）：
#    DRY_RUN=false 会**同时**打开 publish 与 edit 的写操作，而"我想抓皇后页面"
#    与"我想往 Musopia 发种"必须各自可控；且极性相反（DRY_RUN 默认 false=写，
#    这里默认 true=不写）。
#    语义：true = 不发详情页请求 + 不入库，但**仍会发 1 次 cookie 探活**
#          （否则分不清"cookie 死了"与"dry-run 在正常跳过"）。
#    ★ 首次打开建议先保持 true 看一两轮日志，确认"没有真的抓详情页"再改 false。
OPENCD_CRAWL_DRY_RUN=true
# crawl 周期（秒）。★ 为什么是 1800 而不是文档原定的 300：
#   300s ⇒ 每天 ~288 轮，而每日请求上限只有 50 ⇒ 配额每轮都用不完就撞日上限，
#   账本与跨天逻辑变成装饰。1800s ⇒ 每天 ~48 轮，「每天 50 请求」才成为**紧约束**。
CRAWL_INTERVAL=1800
# 每轮最多抓几个页面。★ 它花的是**皇后请求配额**（与 scan/edit 各自独立）。
# 与 OPENCD_MAX_PER_DAY=50 留余量：50/20 ⇒ 一天最多 2~3 轮真抓。
CRAWL_LIMIT_PER_ROUND=20

# ★★ vtid 阶段（皇后页面 id 的**唯一来源**）—— 2026-09-23 新增。
#    跑 `sync_opencd_tid.py --apply`：读 **vertex2** 的库，按 **infohash** 配对出
#    皇后的 `details.php?id=`，写进本库的 `tasks.opencd_tid` 空白列。
#    ★ 为什么它**必须排在 crawl 之前**：先拿到 tid，才知道要抓哪个页面。
#    ★ 为什么默认**开**（与 crawl 的默认关正好相反）：它**纯本地、零请求** ——
#      不 import requests、不 import crawl，只读打开别人的库（mode=ro + query_only=1）。
#      ⇒ 默认开着**不改变对外行为**。
#    ★ 它**会**写本项目的库（只填 opencd_tid 为空的那些行，绝不触碰 updated_at）。
#      `DRY_RUN` **不管**它 —— DRY_RUN 管的是"往 Musopia 写"，而这里动的是本地
#      库的一个空白列（同 crawl 的理由）。
#    ★★ 源读不到时它**非零退出**（脚本纪律 4：绝不降级成"没有可回填的行"）。
#      而 daemon 的"连续失败 ⇒ 指数退避"正是**想要的**：挂载丢了 / 库改名 /
#      表结构漂了 ⇒ 阶段失败 ⇒ 退避 ⇒ 日志可见。
ENABLE_VTID=true
# 与 SYNC_INTERVAL 同周期 —— 它没有"每天都变"的东西：新种子靠 vertex2 那边的
# RSS 周期进库，一天一次足够。
VTID_INTERVAL=86400
# 容器内读的那份 vt 库路径。★ **由 docker-compose.yml 的 environment 提供**
# （写死 /vertex/sql.db，与上面那条只读挂载配对）；这里列出只为可检索，
# 填了也会被 compose 的 environment 覆盖。
VERTEX_DB=/vertex/sql.db
# 只读挂载的**宿主机目录**（compose 的 ${VERTEX_DB_DIR}）。默认值是实测过的：
#   ls //iSunker-DS423/docker_ssd/vertex2/vertex/db  ⇒ sql.db 在（22MB）。
# ★ 对不上时**不会静默跳过** —— sync_opencd_tid.py 会报「外部库不存在」并非零退出，
#   daemon 记失败并退避（见上面 ENABLE_VTID 那段）。这条是故意的。
VERTEX_DB_DIR=/volume2/docker_ssd/vertex2/vertex/db

# 各阶段周期（秒）。sync 只是补 ID，一天一次足够。
# EDIT_INTERVAL 只是**没活时**的兜底周期 —— 有变更待推时，daemon 会按
# EDIT_COOLDOWN 连续处理，待办清零才回到这个长周期（见下面"编辑相关"）。
SCAN_INTERVAL=1800
PUBLISH_INTERVAL=1800
SYNC_INTERVAL=86400
COVERS_INTERVAL=21600
EDIT_INTERVAL=21600

# 每轮限量：站点是别人的，别一次几百条打过去。0 = 不限。
# ⚠️ EDIT_MAX_PER_CYCLE 的值必须和 daemon.py 里的兜底默认值一致（都是 100）：
#    本文件一旦缺这行键，程序就静默按兜底值跑，慢几倍且不报错。
SCAN_MAX_PER_CYCLE=0
# ★★ 每日发布上限 = (86400 / PUBLISH_INTERVAL) × PUBLISH_MAX_PER_CYCLE。
#   2026-09-24 从 `5` 改成 **`1`**：`86400/1800 = 48 轮/天` × 1 = **48 条/天**。
#   （改之前是 48 × 5 = 240 条/天 —— 那是**无人值守**下的量，偏大。）
#   ★ 别把它当成"限速"的**唯一**旋钮：条与条之间的节奏另有 `PUBLISH_MIN_GAP`。
#     两者分工见下面那一段 —— **日上限看这里，突发形态看那里**。
# ⚠️⚠️ 本行的兜底方向是**危险的那一侧**，与 EDIT_MAX_PER_CYCLE **正好相反**：
#   daemon.py 读它用的是 `env_int("PUBLISH_MAX_PER_CYCLE", 0)` ⇒ 兜底是
#   **`0 = 不限`**。所以本文件若**缺**这一行键，publish 会**无人值守地把整个
#   队列发出去**（不是"慢几倍"，是"瞬间发完"）。
#   ⇒ 这与 EDIT_MAX_PER_CYCLE 那条警告是**相反**的失效方向，别套用同一条推理。
#   ★ 生产实际值以 **NAS 上的 `.env`** 为准（它不在 deploy.sh 白名单里，ERR-ENV-02）。
PUBLISH_MAX_PER_CYCLE=1
# ★★ 两次**发布之间**的最小间隔（秒）—— 2026-09-24 新增。0 = 不限（模板默认）。
#
#   ★ 它管什么：**一条种子**的节奏。一条种子 ≈ **3 个站点请求**
#     （`takeupload.php` 上传 → `edit.php` 回读校验 → `download.php` 取回种子），
#     中间还夹一次 qBittorrent 回加 ⇒ 它**包住**了整个"发一条"的动作。
#   ★ 与 `musopia.py` 的 `request_interval`（1.5s）**不是一回事**：
#     那个是**单个请求**之间的地板，它对"一条发完了没有"**完全无感**。
#     ⇒ 两个都留着，别把其中一个调大了当另一个用（那是 `ERR-META-03` 的形状：
#       看起来改了一处，其实管的不是那件事）。
#   ★★ 它**不降低每日上限** —— 这是本文件**最容易读错**的一处：
#     5 条 × 120s = 10 分钟 < 30 分钟一轮 ⇒ **塞得下，上限一条不少**。
#     日总量请改 `PUBLISH_MAX_PER_CYCLE`，**不要**指望这里。
#     它只是把"一批"**摊开**，不是把"总量"**压小**。
#   ★ 什么时候它真的有用：
#     ① 人工 `publish.py --limit N`（或 `--only` 点名一批）—— 那条路**没有**
#        daemon 的 30 分钟轮间隔兜着，改动前 N 条会在几秒内全糊出去；
#     ② 将来若把 `PUBLISH_MAX_PER_CYCLE` 调大 —— 那时每轮才有"一批"可摊。
#   ★ 人工路径**同样受它约束**（🔴 不带 `--auto` 也生效）：
#     人在终端前，并不能让站点少挨几下。要临时加速：跑之前
#     `PUBLISH_MIN_GAP=0 python publish.py ...`（★ 不设 CLI 开关，
#     免得同一个判据有两个真值来源）。
#   ⚠️ 它是**串行等待**：N 条要等 `(N-1) × 本值` 秒。daemon 的 `STAGE_TIMEOUT`
#     默认 3600s ⇒ 本值 120 时约 **29 条**是上限，再多 daemon 会**中途杀掉**该
#     子进程（★ 已发出去的种子不受影响，但汇总与退出码会丢 ⇒ 被记成阶段失败
#     ⇒ 触发指数退避，反而拖慢自动发布）。运行前会打印预计耗时并在超限时告警。
#   ⚠️ 0 = 关闭（模板默认 = 与加这个参数之前完全一样）。负数 / 非数字 ⇒ 按 0
#     处理并打警告（**不会**让发布失败 —— 配置笔误不该让发种停摆）。
#   ★ 它**不由 daemon.py 读取、也不作为参数传给 publish** —— 容器经
#     `env_file: .env` 直接看到它，唯一的读取点是 `publish.py`。
#     ⇒ 想改**只改这一处**，别去 daemon 里加接线（那会变成两份真值）。
PUBLISH_MIN_GAP=0
COVERS_MAX_PER_CYCLE=20
EDIT_MAX_PER_CYCLE=100

# 编辑相关
# 提交后回读详情页确认封面真的落地了
EDIT_VERIFY=true
# 两次站点请求最小间隔秒数
EDIT_REQUEST_INTERVAL=1
# 有变更待推时的重跑间隔（秒）。daemon 每轮 edit 跑完，若发现待办还没清空，
# 就按这个间隔接着跑，直到清零才回到 EDIT_INTERVAL 的长周期。
# 没有它，刚被标脏的记录要干等满 EDIT_INTERVAL（6h）才会上站。
# ⚠️ 每一轮都是真的去读写站点页面，别设得比站点能承受的频率更小。
EDIT_COOLDOWN=60

# 调度器自身
# 多久检查一次有没有到期的阶段
SCHED_TICK=30
# 单个阶段最长跑多久，超时就终止
STAGE_TIMEOUT=3600
# 容器启动后不立刻跑一轮，等各阶段自己的周期到期再动
# （重启/重建容器不会马上敲站点；state 文件里记着上次运行时间）
RUN_ON_START=false
# 连续失败时的最大退避（Cookie 过期别每半小时空敲一次）
MAX_BACKOFF=21600

# 安全阀：库是空的还开着发布 = 可能把 qB 里所有种子重复发一遍。
# 除非确认是全新部署，别打开。
ALLOW_EMPTY_DB=false

# 宿主机路径（compose 里用到）
MUSIC_DIR=/volume1/video/music
INCOMPLETE_DIR=/volume2/qb_temp/temp_docker_opencd

# 编辑限速：每分钟处理多少个种子（按种子计，不是按请求计）
EDIT_RATE_PER_MIN=10
