# 复制这个文件为 .env，并填入真实值。.env 不要提交到 git（记得加进 .gitignore）。

# ---- qBittorrent ----
# 单容器 + network_mode: host（见 docker-compose.yml 的 x-common），容器直接共享宿主机网络栈，
# 所以填「宿主机自己访问 qB」的真实地址：
#   如果 qBittorrent 和 Docker 跑在同一台机器上，用 127.0.0.1；
#   如果 qBittorrent 在局域网里的另一台设备上，用那台设备的局域网 IP（比如 192.168.0.7）。
# ★ 别写 host.docker.internal —— host 网络下没有这条 DNS 记录（ERRATA.md 的 ERR-DOCKER-04）。
# ★ 端口填 NAS 上 qB 实际的 WebUI 端口。
# ★★ 2026-10-07（#92）/ 2026-10-08：发种回加的目标 = **publish 发种专用实例**
#   （2026-10-07 从 opencd(:3020) 改为 :3040；2026-10-08 生产又改到 **:3010**）。
#   两条发种路径（乌托邦/蟹黄堡）共用本值（唯一构造点 qb_client.build）。
#   ★★ **scan 不读本值**（那是 ERR-ORCH-02 的根因）—— scan 要走 `QB_HOST_OPENCD`（下面）。
# ★ 这一行要**显式写**：漏了**不会报错**（会静默用兜底）。
#   ★★★ 2026-10-18（C1，ERR-META-33）：兜底**曾**与生产真值不一致（3040 vs 3010）且
#   一直无人察觉；现 compose 两处 + `config.QB_HOST_DEFAULT` **三处已统一为 3010**。
#   但"兜底改对了"只是止血 —— 真正的护栏是**可观测**：用兜底时 daemon 启动日志会打
#   `⚠️ QB_HOST 未从 .env 读到`，`daemon_env.json` 也会记下本键的值。⇒ 看到那句 ⚠️
#   就来这里补一行，别让地址由兜底决定。
# ★ 旧的 QB_HOST_SCAN / QB_HOST_PUBLISH 是双容器时代的键，现已无任何代码读取；
#   旧 .env 里留着不影响运行，可删（ERRATA.md 的 ERR-ENV-01）。
# ★★★ 2026-10-10（#16，ERR-ORCH-02）：**但它们的"语义"没有消失，只是换了载体** ——
#   `QB_HOST`（本行）现在是**发种实例**（回加用），而 **scan 读皇后源**要靠下面的
#   `QB_HOST_OPENCD`。★ 千万别以为"删掉旧双钥匙"就等于"只剩一个 qB 地址"：
#   一个变量、两个消费者（scan 要皇后源 / 回加要发种实例）是**本项目测出来的铁律**。
QB_HOST=http://127.0.0.1:3010
# ★★★ 2026-10-10（#16）：**皇后源实例**（opencd 分类原种/数据所在）的地址 —— 第二个真值来源。
#   ★ 它是**两个**语义的共用口径：
#     · **scan 阶段**（`run.py`）：读皇后的 `opencd` 分类 ⇒ 必须连**皇后源**
#       （生产 = `3260` qbit-music3，**1376 个 opencd**）。
#     · **交棒链路**：`publish._opencd_content_host()` / `daemon.HANDOFF_HOST_3020`
#       都优先读本键（查原种 content_path / 加种）。
#   ★★ 为什么**必须**独立于 `QB_HOST`（本 bug 的根因）：2026-10-08 为**发种**把 `QB_HOST`
#     从 3040 改成 3010 后，scan 因为**也跟着读 `QB_HOST`** 而被一起带偏 —— 去 3010
#     （发种实例，**0 个 opencd**）找皇后种子 ⇒ 每轮「找到 0 个分类为 [opencd] 的种子」
#     ⇒ **队列只出不进、见底** ⇒ 站点"不发种了"。全程**不报错**（0 行是合法空集）。
#   ★★★ 生产 `.env` 里 `QB_HOST_OPENCD=http://127.0.0.1:3260`；兜底也给 3260。
#   ★ 若显式要覆盖 scan 的源（一般不用）：另有 `QB_HOST_SCAN`（优先级最高，向后兼容旧键名）。
QB_HOST_OPENCD=http://127.0.0.1:3260
QB_USER=admin
QB_PASS=changeme

# ---- qBittorrent API Key（★ 可选，留空即回退账号密码）----
# ★★ 为什么有这个东西（ERRATA.md 的 ERR-QB-08）：qB 5.x 对**登录接口**
#    （/api/v2/auth/login）做**失败计数**，而本项目原本有 13 处各自
#    `Client(...) + auth_log_in()` —— 每起一个进程 / 每次 daemon 扫到待回加，
#    都在**再登录一次**。凭据一旦过期或配错 ⇒ **重试本身**把 IP 顶到封禁：
#        身份认证失败次数过多，您的 IP 地址已被封禁（登录接口 HTTP 403）。
# ⇒ 正确形状是**修凭据路径，不是加重试**（错误 RETRYABLE=False）。
# ★ API Key 走 `Authorization: Bearer <key>`，**不碰登录接口** ⇒ 无失败计数
#    ⇒ 不会被自己的重试封掉。
# ★ 取 key：qB WebUI → 选项 → WebUI → 「API 密钥」栏（或直接看 qB 的
#    qBittorrent.conf 里 `WebUI\APIKey=` 这一行）。
# ★★ 配了这个键，全项目 13 处构造会统一走 key（唯一的构造点在 qb_client.py，
#    由 `run.py --selftest` 的 ⑧ 判据钉住）。
# ★★ 这是**凭据**：不要打印、不要进日志、不要提交 git。
# ★★ **必须手工加到 NAS 的 .env**：deploy.sh 的白名单不含 .env（照 ERR-ENV-02）。
# ★ 留空 = 行为与从前**逐字相同**（回退用户名/密码 + auth_log_in）。
QB_API_KEY=
# ★★★ 2026-10-07（#129）：**皇后源实例**（opencd 原种/data 所在）自己的 API Key。
#   ★ 谁用它：(a) **交棒链路**查原种 `content_path`（`publish._opencd_content_host()` 指此实例）；
#     (b) 2026-10-10（#16）起 **scan 阶段**也用它构造皇后源客户端（`run.py` 的 scan）。
#   ★★ 为什么**必须**再开一个键（实测，不是洁癖）：`QB_API_KEY` 指**发种实例**（`QB_HOST`）。
#     而本键指**皇后源**（`QB_HOST_OPENCD`）—— 若复用 `QB_API_KEY`，就是**拿发种实例的 key
#     打皇后源** ⇒ 皇后源回 **403** ⇒ scan「找到 0 个」/ 交棒在"定位 HDD 目录"那步**静默失败**
#     （`_resolve_opencd_content_path` 返回 ""）。★ 一般化：**凭据按"主体（哪个实例）"分，
#     不按"项目"分**（ERR-ORCH-02 / ERR-PUBLISH-05 同一族）。
#   ★★ qB 5.2.4 实测铁律（NAS-92g）：API Key 必须 `qbt_`+28 位 = **32 位总长**；
#     36 位能存进 conf 但 `Authorization: Bearer` 会 **403**。且改 key 必须"**停容器→改 conf→起**"
#     （`app/setPreferences` 改 `web_ui_api_key` 返回 200 但**不生效**）。
#   ★ 留空 ⇒ 该客户端回退用户名/密码（`QB_USER`/`QB_PASS`——各实例同账号即成立）。
#   ★ 也是凭据：不打印、不进日志、不提交 git。**必须手工加到 NAS 的 .env**（ERR-ENV-02）。
QB_API_KEY_OPENCD=


# ---- Musopia 站点 ----
MUSOPIA_URL=https://www.example.com
# 从浏览器登录后的 Cookie 里复制 c_secure_pass 的值（不要带 "c_secure_pass=" 前缀之外的其它 Cookie）
MUSOPIA_COOKIE=c_secure_pass=changeme
MUSOPIA_PASSKEY=changeme

# ---- PicGo 图床 ----
PICGO_API_KEY=changeme

# ---- Lsky Pro 图床（★ 蟹黄堡专用）----
# ★★ 为什么是两个图床：乌托邦用 PicGo（上面那个），蟹黄堡要用**它自己的**图链。
#    用户 2026-09-25 明确要求，且**不能混用**（拿 picgo 的链去发蟹黄堡是跨站引用）。
#    ⇒ 封面按站各存一份，见 db.site_publish 的 cover_url。
# ★ token 从哪来（★★ 2026-09-27 改：**推荐用账号密码自动换**，见下面 LSKY_EMAIL）：
#    登录 https://img.crabpt.vip → 「接口」页 → 生成 Token。
#    请求头是 `Authorization: Bearer <token>`（★ 与 PicGo 的 X-API-Key 不同）。
# ★★★ 为什么**不推荐**手工往 LSKY_TOKEN 里填（这是实测踩出来的）：
#    站点文档原话是「当前版本接口采用『HTTP 基本验证』的方式验证授权，
#    **获取到 token 后**，通过设置请求 header 标头来验证请求(Bearer Token)」
#    —— 那句话里有**两个**动作。手工复制只覆盖了第二个，而**人眼分不出
#    "token" 与"浏览器 Cookie 串"**（两者都是长随机串）。实测有一次填进去的
#    是 `XSRF-TOKEN=...; crabpt_session=...`（714 字符）⇒ 打过去 **HTTP 401**，
#    且因为 upload_to_lsky() 只在**真发布那一刻**才调它，这个错**潜伏了两天**。
# ★★ 所以：**优先配 LSKY_EMAIL / LSKY_PASSWORD**，token 由程序自己换并缓存到
#    `${DATA_DIR}/lsky_token.json`（缓存是为了省接口配额 —— 文档里 429 = 超出配额）。
#    LSKY_TOKEN 保留为**兜底**（程序换不到时才用它），不再是首选。
# ★★ 这几个键**必须手工加到 NAS 的 .env**：deploy.sh 的白名单不含 .env
#    （那里面是生产独有的真凭据），照 ERR-ENV-02。
# ★ 没配的后果是**明确**的：upload_to_lsky() 打印原因并返回空 ⇒
#    蟹黄堡那条**不发布会**（而不是发一条没封面的）。
# ★ 改完怎么验（**便宜、不发布、不扣配额**）：
#      docker exec -w /app opencd2musopia python assets.py
#   要真换一次 token（**会扣一次接口配额**）：加 `--online`。
LSKY_API_URL=https://img.crabpt.vip/api/v1
# ★ 推荐路径：账号密码（程序自己换 token）
LSKY_EMAIL=
LSKY_PASSWORD=
# ★ 兜底路径：手工从「接口」页复制的 token（留空即可，除非换 token 走不通）
LSKY_TOKEN=
# ★ 可选：token 缓存路径。留空 = `${DATA_DIR}/lsky_token.json`
# LSKY_TOKEN_FILE=
# ★★ 2026-10-10：**上传前的压图目标上限（字节）**。留空 = 默认 **5 MiB**（5242880）。
#   ★ 为什么有它：Lsky 对单图有体积上限，**超限整条拒收**（实测：15.6MB 被拒 / 0.7MB 通过）。
#     旧路径把"太大"当成"本条暂时不可用 ⇒ 跳过"，而蟹黄堡队列按**最老优先、确定性排序**
#     ⇒ 队首那条每轮都撞同一堵墙 ⇒ **永久卡死、连续数日零出种**（详见 ERRATA 的 ERR-PUBLISH-16）。
#   ★ 现在的行为：上传前若超限，用 Pillow 缩放+降质压到 ≤ 本值再传（原图不动、另存 `.lsky.jpg`）；
#     压到最低仍超限才判"本条封面不可用" ⇒ 发布循环**跳过本条、继续试下一条**（不堵队列）。
#   ★★ 量纲提醒：本键 = **上传目标**；pick 阶段的 `MAX_COVER_BYTES`(15 MiB, 见 assets.py) 是
#     "太离谱的先跳过"的第一道预检，**两者不是一回事**，别拿一个当另一个用（ERR-META-03）。
#   ★ 本键**必须手工加到 NAS 的 .env**（deploy.sh 白名单不含 .env，照 ERR-ENV-02）；不填=用默认。
# LSKY_MAX_BYTES=5242880

# ---- 外站封面下载代理（2026-10-11 #15，可选） ----
# ★ 皇后封面约一半是**外站图**（img2.pixhost.to 等），对本 NAS 出口 IP 间歇 reset/超时。
#   NAS 上有可用代理（实测 192.168.0.7:7894 经它取 pixhost 封面全成功）⇒ 在这里填上即可，
#   生产端自己就能取外站封面，不必每次手工。
# ★ 只管 cover_fetch 的**外站封面下载**这一条路；不碰站内请求 / 上传(POST) / qB。
# ★ **默认空 = 直连**（不填行为零变化）。值是 `host:port`（可带 http://），不是凭据。
# ★ `COVER_NO_PROXY`：不经代理的域名/网段（子串匹配，逗号分隔），默认空。
# COVER_PROXY=192.168.0.7:7894
# COVER_NO_PROXY=open.cd

# ---- 皇后种识别口径（一般不用改） ----
# ★★ 2026-10-11（#10/#172）改判：识别皇后种从 `OPENCD_CATEGORY` 改为 **tracker 主机名**。
#   原因：生产 3260（皇后源）1433 个种里只有 **6 个**带 `opencd` 分类（category 口径早已
#   失效），而 tracker=tracker.open.cd 覆盖 **1292** 个（最全、语义最准 = "这个种来自皇后"）。
#   详见 ERRATA 的 ERR-ORCH-03。
#   ★ 值是 **tracker 主机名**（不含 `https://`、不含 `/announce.php`），匹配走**精确相等**。
#     皇后若换 tracker 域名，改这一个键即可，不动代码。
#   ★ 注意：qB 服务端的 `tracker=` 查询参数在本版本**无效**（传任何值都返回全部）⇒
#     过滤在 Python 侧做（见 run._torrent_is_opencd / ERR-QB-09）。
#   ★ 不填 = 用默认 `tracker.open.cd`（NAS 上无需新增此键）。
# OPENCD_TRACKER=tracker.open.cd
# ★ `OPENCD_CATEGORY` 保留仅为向后兼容（旧 .env 仍可读），**scan 已不再引用它**。
OPENCD_CATEGORY=opencd
PUBLISH_CATEGORY=Musopia

# ---- ★★ 发布前跨站查重（#13 / #11 核心，2026-10-11 加） ----
# ★ 干什么：发布**之前**先在目标站点搜一遍，比对站侧 `.torrent` 的 `info.name`
#   与本地 `.torrent` 的 `info.name`（归一化后**精确相等**）。相等 ⇒ 站点已有同版本
#   ⇒ **不再重复提交**，改为把本地行**关联**到已有站点页（乌托邦写 site_status=EXISTS +
#   site_publish tid；蟹黄堡只写 site_publish）。
# ★★ 为什么需要它（病根）：pipeline 原先**只信本地 `site_status`**、从不问目标站点
#   "有没有" ⇒ 同一专辑以不同 tid/路径再入库时就发重复种 ⇒ 站点用**不透明的**
#   「上传失败！」拒绝（正文零消息）⇒ 近 15 条 FAILED 里 ≈11 条是重复。
# ★★★ 默认 **开**（2026-10-11 用户拍板）。为什么默认开是安全的：
#   · 它**只多读、不多写** —— 没命中就**照旧提交**（行为与从前逐字相同）；
#   · 命中才改动作（关联而非重复提交）—— 那正是我们要的；
#   · 查重**搜索本身失败** ⇒ 停轮 + 非 0（触发 daemon 退避），
#     **绝不**把"搜不了"静默降级成"没重复"（否则又会发出一条重复种）。
# ★ 要回旧行为：显式设 `false`（如站点搜索接口临时不可用、你想临时绕开时）。
DEDUP_BEFORE_PUBLISH=true

# ★★★ 发种前**版本一致性闸门**（2026-10-14 加，`ERR-PUBLISH-20` 修复③）—— 一般不用改。
# ★ 干什么：`upload_torrent` **之前**，**纯本地**查两件事，任一不符即**拒发**（标 FAILED 出队）：
#     ① DB 记的 `track_type` vs **现在**从本地目录重算的版本（库 vs 盘上实况）；
#     ② 本地 `.torrent` 的文件集 vs 本地内容目录的文件集（要发的 ≠ 盘上的）。
# ★ 为什么必须有它（根因）：本地目录**实为分轨**，却因一个**指向不存在 WAV 的 .cue**
#   被旧判据当整轨 ⇒ 站点标题挂错版本 ⇒ 站点那条**永远校验停在半途**，
#   且程序**无删站点种能力** ⇒ 只能人工删种（`#136` 族第 3 次复发）。
# ★★★ 默认 **开**（2026-10-14 用户拍板，安全侧）。为什么默认开是安全的：
#   · **零网站请求**（只读盘 + 读本地种子）；
#   · 一致性 ⇒ **照旧提交**（行为与从前逐字相同）；
#   · 一致性**比不了**（目录不在 / 种子读不出 / 一侧为空）⇒ **不拦**并显式打印"跳过"
#     —— 绝不让"不可知"变成"拒发"。
# ★ 要回旧行为：显式设 `false`。
VERSION_GATE_BEFORE_PUBLISH=true

# ★★★ 查重「召回」子查询上限（#23，2026-10-11 加）—— 一般不用改。
# ★ 为什么有它：#13 初版**只发一条**搜索串，而站点搜索是 **AND + 对标点敏感**
#   （对「显示标题」字段匹配）⇒ 长名/带标点的本地标题（如
#   `Stravinsky; … Hannigan - Chamber Works 2024 - FLAC 整轨 - OpenCD`）**整串返回 0 候选**
#   ⇒ **假阴性** ⇒ 站点上明明有、却当"没有" ⇒ 照旧提交 ⇒ 又一条重复种（实测 3 条已知
#   重复里只有 1 条单串能召回；CJK 长名任何单串都 0 候选）。
# ⇒ #23 改为按 `musopia.SEARCH_QUERY_PLAN` 发**多条子查询**取并集
#   （头 3 token + 尾 3 token + 2 个均匀内部窗口；token 取自**本地 `.torrent` 的 info.name**）。
# ★ 值 = **每条专辑**最多发几次搜索请求。**默认 5**（实测对 12 条真实"已在站"行召回
#   12/12、目标落点 pos ≤ 2）。
# ★★ 召回**宽**只多花请求、**不会**制造假阳性 —— "是不是同一版本"由站侧 `.torrent` 的
#   `info.name` **精确相等**判定（`site_verify`），与召回宽度无关。
# ★ `<=0` ⇒ 只发 1 条（= #13 初版行为，**不**回退到"不查重"）。真要整条关掉用上面那个。
# ★ 本键**必须手工加到 NAS 的 .env**（deploy.sh 白名单不含 .env，照 ERR-ENV-02）；不填=默认 5。
# DEDUP_MAX_SEARCH_QUERIES=5

# ★ 蟹黄堡（第二发布站）在 qB 里的分类 —— **与乌托邦分开**，便于"哪条种子属于哪一站"
#   在 qB 里一眼可辨、也便于按站统计（2026-10-03 接线到 publish.py::readd_to_qb_crabpt）。
# ★★ 只影响**此后新加**的种子；qB 里**已有**的蟹黄堡种子仍挂在 PUBLISH_CATEGORY
#   名下，**不会自动迁移**。
# ★ 需在 qB 里**先建好**这个分类（qB 不自动创建）；留空/指向不存在的分类
#   ⇒ 种子仍入库但分类为空。若不想分，把它设成与 PUBLISH_CATEGORY 同值即可。
CRABPT_PUBLISH_CATEGORY=CrabPT

# ---- ★ 星湾（xingwan.cc，第四发布站，2026-11-10 加）----
# 站点地址（一般不用改）
XINGWAN_URL=https://xingwan.cc
# ★★ 必填：浏览器登录星湾后复制**整串** Cookie。留空 ⇒ publish.py 直接拒绝提交。
#    失效时 check_login() 会明确报「Cookie 已失效」，不会静默继续。
XINGWAN_COOKIE=
# 音乐分类（星湾「HQ Audio」= 408）
XINGWAN_MUSIC_CATEGORY=408
# ★ 回加 qB 时打的**标签**（不建分类 —— 星湾用标签识别本项目种；标签无需预先创建）
#   交棒/巡检/清盘按它（`HANDOFF_OWN_TAGS`，默认就是本值）判定"这是本项目种"。
XINGWAN_PUBLISH_TAG=Xingwan
# 每轮最多成功发布几条
XINGWAN_MAX_PER_CYCLE=1
# ★★★ 仅星湾生效的发种窗口：每天 00:00-10:00 参与发种，其余时间 daemon 直接跳过该阶段。
#   其它三站仍按各自周期全天发布（全局 PUBLISH_WINDOW 若配置，仍会叠加生效）。
XINGWAN_PUBLISH_WINDOW=00:00-10:00
# 是否启用星湾发布阶段（首次接入建议先 false，手工 dry-run 验证后再开）
ENABLE_PUBLISH_XINGWAN=false
XINGWAN_INTERVAL=1800
# 星湾页面编辑阶段（独立 cookie；默认关闭）
ENABLE_EDIT_XINGWAN=false
EDIT_XINGWAN_INTERVAL=21600
EDIT_XINGWAN_MAX_PER_CYCLE=100

# ---- ★ 延迟回加 qB（延迟做种，2026-10-03 加）----
# ★ 干什么：种子**发布成功后不立即加进 qB**，等这么多分钟再加 ⇒ qB 收到后自己
#   校验、自己做种。目的：别人 RSS 到这条种子有时差，延迟一会儿让**尽量多的人
#   同时开始下载**（=扩散更广）。★ 15 是暂定值，**没实测**哪种最合适。
# ★★ 默认 **0 = 关闭**（= 发布后立即回加，老行为）。要开**显式**设 >0 分钟。
# ★ 实现：publish.py 把待回加写进 `/data/readd_queue.json`（含 .torrent 字节），
#   daemon.py 主循环每 SCHED_TICK(30s) 扫一次，到点才 add。详见 readd_queue.py。
# ★★★ 已知干扰（2026-10-03，用户决定先忽略）：延迟窗口内，NAS 上别的容器
#   （reseed/iyuu 辅种那套）若看到站点有新种、自动辅种，可能**抢先**把它加进 qB
#   ⇒ 延迟失效。本项目**不拦不检测**，仅此记录，供排查"延迟没生效"时第一顺位怀疑。
SEED_DELAY_MIN=0

# ---- OpenCD（皇后）转载流水线 —— 第二阶段的凭据 ----
# ★ 这是**皇后的** Cookie，跟上面 MUSOPIA_COOKIE 是两个站、两个账号，别混。
# ★ 用途：crawl.py 抓皇后详情页。缺了它 crawl 会在 check_login() 前直接退出（退出码 2）。
# ★★ 从浏览器登录皇后后，从 Cookie 里复制**整个** Cookie 串（含 c_secure_pass 那一段）。
#    与 MUSOPIA_COOKIE 不同 —— 那个只取 c_secure_pass，皇后这边给整串更省事。
# ★★ 配好之前**不要**把 crawl 接进 daemon 调度：否则每轮
#    就因缺 Cookie 白跑一轮，而且那是配置缺失、退避救不了。
# ★ 这一行**不在 .env.example 之外的地方维护** ——
#    .env 不在 deploy.sh 白名单（ERR-ENV-02），所以加了这里之后
#    **还要在 NAS 上手工把它填进那份 .env**。
#   ★ 2026-09-22：cookie 失效**不会静默** —— crawl 探活失败 ⇒ 退出码 1 ⇒
#     daemon 记连续失败并指数退避；且 daemon_state.json 里 crawl.last_ok=false，
#     每小时巡检会报出来。★「发邮件告警」并入每日邮件待办，
#     本期**不实现 SMTP**（避免引入新凭据管理）。
OPENCD_COOKIE=changeme
# 皇后站点地址（有兜底 https://open.cd，一般不用改）
OPENCD_URL=https://open.cd
# ★ 抓取层的频率控制（三道闸门，见 opencd_rate.py）
#   ★ 「省请求靠抓过就跳，不是把间隔调大」—— 这几个值别乱调大
#   ★★ 量纲提醒：下面三个**全是「请求」量纲**，没有「种子」概念。
#      ✅ 2026-09-23 量纲订正：**一条种子 = 1 个请求**（只抓详情页，抓过的还跳过）。
#         ⇒ OPENCD_MAX_PER_DAY=500 现在约等于 **500 个页面/天**。
#         ★ 旧的「一种子 ≈ 2~3 请求 ⇒ 约 17~25 种子/天」是**名称搜索时代**的比例，
#           随那条路一起作废（按名字搜 1 次 + 验候选 1~5 次）。照旧比例估产能会
#           **低估一倍**（ERR-META-04：改了行为却不改文档）。
#   ✅ 2026-09-22：跨轮持久**已启用** —— 计数落在 data.db 的 opencd_quota 表里，
#      所以「每日 500」现在是**真的每日 500**（不再是"每轮 20"）。
#      ⚠️ 但量纲仍是**请求**（不是种子）—— 想按种子卡要在入库那步记 kind='seed'，
#         见 opencd_rate.py 模块头「已知缺口」①（**别读成已解决**）。
#   ★★ 2026-10-12：用户要求每日上限 **50 → 500**（站点允许一天搜 500 次）。
#      ★ 最小间隔 OPENCD_MIN_INTERVAL(120s) **保持不变**（站点礼仪，另需批准）。
#   ★ 这三行的兜底值 = 用户要的值 ⇒ **NAS 上不填也正确**；
#     填进来是为了「由 .env 钉住」，而不是靠代码兜底（谁动一下兜底就静默换）。
#     注意 .env 不在 deploy.sh 白名单（ERR-ENV-02），所以要 NAS 上手工填。
OPENCD_MAX_PER_ROUND=20      # 每轮最多几个请求（防某天突然涌入几百个）
OPENCD_MIN_INTERVAL=120      # 两次请求最小间隔（秒）— 只防瞬时连击，不是节奏控制
OPENCD_MAX_PER_DAY=500       # 当日请求上限（硬刹车）— ★ 请求量纲，非种子数
# OPENCD_RAW_DIR=/data/raw_html  # 详情页落盘目录（兜底 = ${DATA_DIR}/raw_html）。
#                                # ★ 落盘是刻意的：解析层永不重复请求，源站改版时重放即可
# ★ 原来的 OPENCD_INTERVAL（阶段周期）已删，改名 CRAWL_INTERVAL（见下面"crawl 阶段"）。

# ---- 状态/产物存储目录（容器内路径，compose 里 bind mount 到宿主机目录 `${STATE_DIR}`，一般不用改） ----
DATA_DIR=/data

# ==================== 容器化自动运行（daemon.py 调度器） ====================

# 总开关：true = 只预览不改站点（首次部署强烈建议先这样跑一轮看日志）
DRY_RUN=false

# 各阶段开关
ENABLE_SCAN=true
ENABLE_PUBLISH=true
ENABLE_SYNC=true
ENABLE_COVERS=true
ENABLE_EDIT=true

# ---- ★★ 自动发布的第二把钥匙（2026-09-24 新增） ----
# 为什么要有它：发布是本项目**唯一不可逆**的动作（站点上没有"批量撤回"）。
# 改动前，"自动发"和"人发的"**共用同一条路径** —— 只要 ENABLE_PUBLISH=true
# 且 DRY_RUN=false，daemon 就会无人值守地把整个队列发出去，人不在回路里。
# ⇒ 现在把钥匙**分开放两处**：
#     · ENABLE_PUBLISH  = 容器的**长期**开关（在 .env 里，改一次一直有效）
#     · PUBLISH_I_AM_HERE = 自动路径**每次执行**都要成立的第二把钥匙
# ★ 判据：这个变量**只在无人值守路径**（`publish.py --auto`，即 daemon 调的
#   那条）上被校验。人在终端前手敲 `python publish.py` **不受影响**。
# ★★ 不填的后果：daemon 的 publish 阶段**每轮都拒绝发布**并以退出码 3 结束
#   ⇒ 触发指数退避 ⇒ **不会**静默地什么都不做（日志里会明写"还没配"）。
#   ★ 这是**刻意**的失败方向：钥匙没配 = 不发。
# ★ 值就是下面这个字面量（连字符不用转义 —— compose 只展开 .env 的**值**，
#   不展开键名）。改了值的唯一后果是"不发"，不会污染任何数据。
# ★ 与 ENABLE_PUBLISH 的关系：**两个都为真**才会自动发。
#   ⇒ 想彻底停掉自动发布，改 ENABLE_PUBLISH=false 更干净（阶段压根不排）。
PUBLISH_I_AM_HERE=i-am-here

# ★★ crawl 阶段（按已知 tid 抓皇后详情页，补 mapped_json）—— 2026-09-23 改指向。
#    ★★ 它以前跑的是 `crawl.py --from-qb`（扫 qB → **按种子名称搜索**皇后 → 验候选
#      infohash → 抓页面）。那条路**已整条删除**（用户决定），三个理由都是实测：
#        ① 一条 2~3 请求（搜索 1 + 验候选 1~5），而 OPENCD_MAX_PER_DAY 当时只有 50；
#        ② 会搜错 —— 搜「齐秦 - 我拿什么爱你」返回 2 条（FLAC 分轨 / WAV 整轨），
#           名字几乎相同，取第一条就发错种子；
#        ③ 抓了也发不出去 —— 它传 qb_seed_days=None ⇒ 每行落 NOT_SEEDED ⇒
#           卡在发布队列闸门①（status='SUCCESS'）⇒ 等于白抓。
#      ⇒ 本阶段现在跑 `topup_opencd_fields.py`（从库里选"有 tid 但 mapped_json 空"
#        的行，逐条抓详情页）。★ **抓页面这件事没有取消** —— 转载规则 / 标签 /
#        媒介 / 製作組 / 艺术家 / 年份**只存在于页面上**，VT 只给页面编号。
#        闸门③④（db.PENDING_PUBLISH_WHERE）正是因此存在。
#    ★ 为什么默认**关**：它是**唯一会主动出网访问别人站点**的阶段。
#      默认关 = 升级镜像**不改变对外行为**，要开必须显式加这一行。安全默认。
#      ★ 2026-09-23 用户："先不开，手动看看效果" ⇒ 保持 false。
#    ★ 为什么它**不会产生任何新发布**：闸门③④ 要求 transfer_rule='ALLOW'，
#      而 crawl 只补内容、不改 status —— 发布仍要过 publish 阶段那一整套闸门。
ENABLE_CRAWL=false
# ★★ dry-run 是**专用**开关，与上面的 DRY_RUN **无关**（两个站、两个风险面）：
#    DRY_RUN=false 会**同时**打开 publish 与 edit 的写操作，而"我想抓皇后页面"
#    与"我想往 Musopia 发种"必须各自可控；且极性相反（DRY_RUN 默认 false=写，
#    这里默认 true=不写）。
#    语义：true = 不发详情页请求 + 不入库，但**仍会发 1 次 cookie 探活**
#          （否则分不清"cookie 死了"与"dry-run 在正常跳过"）。
#    ★ 首次打开建议先保持 true 看一两轮日志，确认"没有真的抓详情页"再改 false。
OPENCD_CRAWL_DRY_RUN=true
# crawl 周期（秒）。★ 为什么是 1800 而不是文档原定的 300：
#   （2026-09-19 定值时每日请求上限才是 50）300s ⇒ 每天 ~288 轮，而日上限只有 50
#   ⇒ 配额每轮都用不完就撞日上限，账本与跨天逻辑变成装饰。
#   1800s ⇒ 每天 ~48 轮。★ 2026-10-12 日上限已升到 500，本周期**不变**即可：
#   48 轮 × 每轮 ≤20 请求 = ≤960 请求/天 > 500 ⇒ 「每日 500」仍是**紧约束**。
CRAWL_INTERVAL=1800
# 每轮最多抓几个页面。★ 它花的是**皇后请求配额**（与 scan/edit 各自独立）。
# 与 OPENCD_MAX_PER_DAY=500 留余量：500/20 ⇒ 一天最多 ~25 轮真抓（受周期再打折）。
CRAWL_LIMIT_PER_ROUND=20

# ★★ vtid 阶段（皇后页面 id 的**唯一来源**）—— 2026-09-23 新增。
#    跑 `sync_opencd_tid.py --apply`：读 **vertex2** 的库，按 **infohash** 配对出
#    皇后的 `details.php?id=`，写进本库的 `tasks.opencd_tid` 空白列。
#    ★ 为什么它**必须排在 crawl 之前**：先拿到 tid，才知道要抓哪个页面。
#    ★ 为什么默认**开**（与 crawl 的默认关正好相反）：它**纯本地、零请求** ——
#      不 import requests、不 import crawl，只读打开别人的库（mode=ro + query_only=1）。
#      ⇒ 默认开着**不改变对外行为**。
#    ★ 它**会**写本项目的库（只填 opencd_tid 为空的那些行，绝不触碰 updated_at）。
#      `DRY_RUN` **不管**它 —— DRY_RUN 管的是"往 Musopia 写"，而这里动的是本地
#      库的一个空白列（同 crawl 的理由）。
#    ★★ 源读不到时它**非零退出**（脚本纪律 4：绝不降级成"没有可回填的行"）。
#      而 daemon 的"连续失败 ⇒ 指数退避"正是**想要的**：挂载丢了 / 库改名 /
#      表结构漂了 ⇒ 阶段失败 ⇒ 退避 ⇒ 日志可见。
ENABLE_VTID=true
# 与 SYNC_INTERVAL 同周期 —— 它没有"每天都变"的东西：新种子靠 vertex2 那边的
# RSS 周期进库，一天一次足够。
VTID_INTERVAL=86400
# 容器内读的那份 vt 库路径。★ **由 docker-compose.yml 的 environment 提供**
# （写死 /vertex/sql.db，与上面那条只读挂载配对）；这里列出只为可检索，
# 填了也会被 compose 的 environment 覆盖。
VERTEX_DB=/vertex/sql.db
# 只读挂载的**宿主机目录**（compose 的 ${VERTEX_DB_DIR}）。默认值是实测过的：
#   ls //iSunker-DS423/docker_ssd/vertex2/vertex/db  ⇒ sql.db 在（22MB）。
# ★ 对不上时**不会静默跳过** —— sync_opencd_tid.py 会报「外部库不存在」并非零退出，
#   daemon 记失败并退避（见上面 ENABLE_VTID 那段）。这条是故意的。
VERTEX_DB_DIR=/volume2/docker_ssd/vertex2/vertex/db

# ★★ rss_tid 阶段（用皇后 RSS **反查**补 tid）—— 2026-10-12 新增（B12）。
#    跑 `rss_backfill_tid.py`：对 `opencd_tid` **为空**的行，拿它的名字搜
#    `torrentrss.php?search=<名字>&rows=100` ⇒ 每条 item 自带
#    `<guid>`=真 infohash、`<link>`→tid ⇒ **逐字节比 hash** 命中即回填 opencd_tid。
#    ★ 为什么需要：`vtid`（上面）只从 **vertex2 外库**拿 tid ⇒ vertex2 没收的种子
#      **永远拿不到 tid**。本阶段补的就是那批（RSS 精确 32% / +模糊 52% 命中）。
#    ★ 为什么默认**关**（与 vtid 的默认开相反）：它**会主动出网访问别人站点**、
#      花**皇后请求配额**（同 crawl）⇒ 默认关 = 升级镜像不改对外行为，要开显式加一行。
#    ★ 它**写本项目的库**（复用 `sync_opencd_tid.apply_tids()`：只填空白、绝不覆盖
#      非空、**不碰 updated_at**）。`DRY_RUN` **不管**它 —— 用下面专用变量。
#    ★ 与 vtid 的分工：vtid 走外部库（零请求，先跑）→ rss_tid 走站点 RSS（出网，后跑）。
ENABLE_RSS_TID=false
# 干跑开关（默认 true = 只报告、不发请求、不写库）。★ 专用变量，**不复用 DRY_RUN**：
#   DRY_RUN=false 会同时打开 publish/edit 的写操作，而"补 tid"与"往 Musopia 发种"
#   是两个风险面；且极性相反（DRY_RUN 默认 false=写，本阶段要求默认 true=不写）。
RSS_TID_DRY_RUN=true
# 与 vtid 同周期（日频）。真闸是 OPENCD_MAX_PER_DAY（配额账本）；周期只决定多久尝试一次。
RSS_TID_INTERVAL=86400
# 每轮最多处理几行（★ 一行 ≈ 1~2 个皇后请求：精确 1 + 不中再模糊 1）。
# ★ 2026-10-12：日上限已升到 500 ⇒ 本阶段可与 crawl 共用同一份请求配额、放量。
#   默认 5 是**保守起步**；确认小样效果后可上调（如 50~100），仍受 OPENCD_MAX_PER_DAY 硬刹车。
RSS_TID_LIMIT_PER_ROUND=5
# ★★ 皇后 RSS 反查的 **passkey**（凭据！）。`torrentrss.php` **要求 query 里带 `passkey=`**：
#   不带 ⇒ 返回纯文本 `passkey error`；带错 ⇒ `invalid passkey`；带对 ⇒ 合法 `<rss>` XML。
#   ★★ **它 ≠ `MUSOPIA_PASSKEY`**（后者是乌托邦(Musopia)的，两个站两个账号，别混）。
#   皇后 passkey 可从**你自己的** 皇后下载链接拿（`download.php?id=…&passkey=<32hex>`）或
#   皇后 RSS 的 `<enclosure url="…&passkey=<32hex>">`。
#   ★ 没配它 ⇒ `rss_backfill_tid.py --apply` **开工前直接退出**（不白敲站点）。
#   凭据纪律：只放这里（生产 .env），**绝不进 git/仓库/日志**。
QUEEN_RSS_PASSKEY=changeme

# 各阶段周期（秒）。sync 只是补 ID，一天一次足够。
# EDIT_INTERVAL 只是**没活时**的兜底周期 —— 有变更待推时，daemon 会按
# EDIT_COOLDOWN 连续处理，待办清零才回到这个长周期（见下面"编辑相关"）。
SCAN_INTERVAL=1800
PUBLISH_INTERVAL=1800
SYNC_INTERVAL=86400
COVERS_INTERVAL=21600
EDIT_INTERVAL=21600

# 每轮限量：站点是别人的，别一次几百条打过去。0 = 不限。
# ⚠️ EDIT_MAX_PER_CYCLE 的值必须和 daemon.py 里的兜底默认值一致（都是 100）：
#    本文件一旦缺这行键，程序就静默按兜底值跑，慢几倍且不报错。
SCAN_MAX_PER_CYCLE=0
# ★★ 每日发布上限 = (86400 / PUBLISH_INTERVAL) × PUBLISH_MAX_PER_CYCLE。
#   2026-09-24 从 `5` 改成 **`1`**：`86400/1800 = 48 轮/天` × 1 = **48 条/天**。
#   （改之前是 48 × 5 = 240 条/天 —— 那是**无人值守**下的量，偏大。）
#   ★ 别把它当成"限速"的**唯一**旋钮：条与条之间的节奏另有 `PUBLISH_MIN_GAP`。
#     两者分工见下面那一段 —— **日上限看这里，突发形态看那里**。
# ⚠️⚠️ 本行的兜底方向是**危险的那一侧**，与 EDIT_MAX_PER_CYCLE **正好相反**：
#   daemon.py 读它用的是 `env_int("PUBLISH_MAX_PER_CYCLE", 0)` ⇒ 兜底是
#   **`0 = 不限`**。所以本文件若**缺**这一行键，publish 会**无人值守地把整个
#   队列发出去**（不是"慢几倍"，是"瞬间发完"）。
#   ⇒ 这与 EDIT_MAX_PER_CYCLE 那条警告是**相反**的失效方向，别套用同一条推理。
#   ★ 生产实际值以 **NAS 上的 `.env`** 为准（它不在 deploy.sh 白名单里，ERR-ENV-02）。
PUBLISH_MAX_PER_CYCLE=1
# ★★ 两次**发布之间**的最小间隔（秒）—— 2026-09-24 新增。0 = 不限（模板默认）。
#
#   ★ 它管什么：**一条种子**的节奏。一条种子 ≈ **3 个站点请求**
#     （`takeupload.php` 上传 → `edit.php` 回读校验 → `download.php` 取回种子），
#     中间还夹一次 qBittorrent 回加 ⇒ 它**包住**了整个"发一条"的动作。
#   ★ 与 `musopia.py` 的 `request_interval`（1.5s）**不是一回事**：
#     那个是**单个请求**之间的地板，它对"一条发完了没有"**完全无感**。
#     ⇒ 两个都留着，别把其中一个调大了当另一个用（那是 `ERR-META-03` 的形状：
#       看起来改了一处，其实管的不是那件事）。
#   ★★ 它**不降低每日上限** —— 这是本文件**最容易读错**的一处：
#     5 条 × 120s = 10 分钟 < 30 分钟一轮 ⇒ **塞得下，上限一条不少**。
#     日总量请改 `PUBLISH_MAX_PER_CYCLE`，**不要**指望这里。
#     它只是把"一批"**摊开**，不是把"总量"**压小**。
#   ★ 什么时候它真的有用：
#     ① 人工 `publish.py --limit N`（或 `--only` 点名一批）—— 那条路**没有**
#        daemon 的 30 分钟轮间隔兜着，改动前 N 条会在几秒内全糊出去；
#     ② 将来若把 `PUBLISH_MAX_PER_CYCLE` 调大 —— 那时每轮才有"一批"可摊。
#   ★ 人工路径**同样受它约束**（🔴 不带 `--auto` 也生效）：
#     人在终端前，并不能让站点少挨几下。要临时加速：跑之前
#     `PUBLISH_MIN_GAP=0 python publish.py ...`（★ 不设 CLI 开关，
#     免得同一个判据有两个真值来源）。
#   ⚠️ 它是**串行等待**：N 条要等 `(N-1) × 本值` 秒。daemon 的 `STAGE_TIMEOUT`
#     默认 3600s ⇒ 本值 120 时约 **29 条**是上限，再多 daemon 会**中途杀掉**该
#     子进程（★ 已发出去的种子不受影响，但汇总与退出码会丢 ⇒ 被记成阶段失败
#     ⇒ 触发指数退避，反而拖慢自动发布）。运行前会打印预计耗时并在超限时告警。
#   ⚠️ 0 = 关闭（模板默认 = 与加这个参数之前完全一样）。负数 / 非数字 ⇒ 按 0
#     处理并打警告（**不会**让发布失败 —— 配置笔误不该让发种停摆）。
#   ★ 它**不由 daemon.py 读取、也不作为参数传给 publish** —— 容器经
#     `env_file: .env` 直接看到它，唯一的读取点是 `publish.py`。
#     ⇒ 想改**只改这一处**，别去 daemon 里加接线（那会变成两份真值）。
PUBLISH_MIN_GAP=0
COVERS_MAX_PER_CYCLE=20
EDIT_MAX_PER_CYCLE=100

# 编辑相关
# 提交后回读详情页确认封面真的落地了
EDIT_VERIFY=true
# 两次站点请求最小间隔秒数
EDIT_REQUEST_INTERVAL=1
# 有变更待推时的重跑间隔（秒）。daemon 每轮 edit 跑完，若发现待办还没清空，
# 就按这个间隔接着跑，直到清零才回到 EDIT_INTERVAL 的长周期。
# 没有它，刚被标脏的记录要干等满 EDIT_INTERVAL（6h）才会上站。
# ⚠️ 每一轮都是真的去读写站点页面，别设得比站点能承受的频率更小。
EDIT_COOLDOWN=60

# 调度器自身
# 多久检查一次有没有到期的阶段
SCHED_TICK=30
# 单个阶段最长跑多久，超时就终止
STAGE_TIMEOUT=3600
# 容器启动后不立刻跑一轮，等各阶段自己的周期到期再动
# （重启/重建容器不会马上敲站点；state 文件里记着上次运行时间）
RUN_ON_START=false
# 连续失败时的最大退避（Cookie 过期别每半小时空敲一次）
MAX_BACKOFF=21600

# 安全阀：库是空的还开着发布 = 可能把 qB 里所有种子重复发一遍。
# 除非确认是全新部署，别打开。
ALLOW_EMPTY_DB=false

# 宿主机路径（compose 里用到）
MUSIC_DIR=/volume1/video/music
INCOMPLETE_DIR=/volume2/qb_temp/temp_docker_opencd

# PUBLISH_DIR：发种成品区（SSD）的宿主机路径。
# ★★ 2026-10-07（#133/#92-f1）**落点订正**：这里必须是 **3040 看得见的**目录！
#   原先指向 `opencd2others/publish_data`（本项目**自己**的子目录）⇒ 复制过去的成品
#   **3040 根本看不到**（3040 的 /downloads 是另一个宿主目录）⇒ 这就是三条种补救时
#   不得不**手工 cp** 的原因。订正后指向 **3040 的 Download 目录**：
#   复制 = 直接写进 3040 的 `/downloads`；3040 加种用 `save_path=/downloads`（父目录语义）。
# ★★ 铁律：该目录**就是 3040 的下载根** ⇒ "清 SSD"只删 `<该目录>/<专辑>` 子目录，
#   绝不删该目录本身（`handoff._safe_rmtree` 有护栏）。
PUBLISH_DIR=/volume2/docker_ssd/qbit-publish/Download

# ---- ★★ 发种交棒（#92 新流程，2026-10-07 加）----
# ★ 流程：成品从 HDD 复制到 SSD 发种区（上面 PUBLISH_DIR）→ 3040 用**站点 .torrent**
#   发种做种 → 满足「出种≥N 或 做种≥D 天」→ 把种子任务交棒到 3020（**零拷贝**，3020 用
#   HDD 原点 `/volume1/video/music` 校验）→ 清 SSD 副本（删 3040 任务 + 删 `<专辑>` 子目录）。
# ★ HDD 原数据**全程不动**；SSD 那份只是"发种用的一次性副本"。
# ★★ 默认**全关**（ENABLE_HANDOFF=false / HANDOFF_DRY_RUN=true）⇒ 不上线时**零行为变化**。
#   要开必须显式在这里设（.env 不在 deploy.sh 白名单，记得手工加到 NAS 的 .env）。
# ★ 这些键**都只控制本项目动作**，不改变对外发布行为。
ENABLE_HANDOFF=false
# ★ 只判定 + 记日志，不真复制/不真交棒/不真删。★ 默认 true（有不可逆的一步：删 SSD）。
HANDOFF_DRY_RUN=true
# ★★ 隔离白名单（用户 2026-10-07 指令：「**仅限本项目的音乐种子**才移动到 3040 交接做种，
#   这个 3020qb 我可能还要发其他种子的」）：判据 = **3040 上的分类命中此白名单**才允许
#   复制/交棒/清盘。留空 = 用默认（= PUBLISH_CATEGORY,CRABPT_PUBLISH_CATEGORY，即 Musopia,CrabPT）。
#   3040 上**未分类/别的分类**的种（用户手加的）⇒ **绝不**碰。
# HANDOFF_OWN_CATEGORIES=Musopia,CrabPT
# ★ 判据一：出种 ≥ N 个（口径 = qB num_complete **减掉自己**，见 handoff.judge）。
HANDOFF_SEEDERS_MIN=3
# ★ 判据二：做种 ≥ D 天（从 qB added_on 起算）。判据是"或"。
HANDOFF_SEED_DAYS=3
# ★ 交棒线程自跑间隔（秒）；每轮最多处理几条。
HANDOFF_THREAD_TICK=300
HANDOFF_MAX_PER_ROUND=5
# ★ 交棒到 3020 时的做种落地根（= 3020 的 /downloads，宿主 /volume1/video/music）。
#   默认 /downloads 即正确，一般不用改。
# HANDOFF_TARGET_SAVE_ROOT=/downloads

# ---- ★★ counts.json 每日快照（#16，2026-10-14 加）----
# ★ 干什么：把**会动的量**（阶段新鲜度 / 心跳 / 库计数 / 生效开关）落成 `/data/counts.json`，
#   **跨项目**供通知中枢 pt-notice 的「源A(opencd2)」采集器读 —— 它把 counts.json 当
#   **权威真值**，据此产出日报里的「阶段存活表 / 上传统计 / 回加台账」。
#   没有它，源A 的阶段台账**整块推不出来**（`state_from_counts({})=={}`）⇒ 日报那节永远空。
# ★★ 默认**关**（ENABLE_COUNTS_SNAPSHOT=false）⇒ 不上线时**零行为变化**。
#   要开必须显式在这里设（.env 不在 deploy.sh 白名单，记得手工加到 NAS 的 .env）。
# ★ 由**独立线程**每天生成一次（`day_key` 闸，避免每 tick 重写）；不受主循环长阶段（crawl
#   ~38min）饿住。生成器 = `tools/gen_counts_online.py`（**只读** data.db，**零凭据**）。
ENABLE_COUNTS_SNAPSHOT=false
# ★ 线程多久查一次"今天生成过没有"（秒）。默认 1h —— 一天一生成，绰绰有余。
COUNTS_SNAPSHOT_THREAD_TICK=3600

# ---- ★★ 镜像拉取策略（2026-10-07 #134 直传部署后加）----
# ★ 两种部署方式各需一个值：
#   · 走 **Docker Hub**（本机 `build-push.sh` 推 → NAS `compose pull`）⇒ 设 `always`：
#     否则本地已有同名 tag 时 `up -d` **不会**去拉新镜像（症状 = ERR-DOCKER-01
#     "push 了但 NAS 跑的是旧的"）。
#   · 走 **直传**（本机 `docker save` → NAS `docker load`，免登录、绕开镜像站 tag 缓存）
#     ⇒ 留默认 `missing`（本地已有该 sha tag 就直接用，**不去 registry 拉**；
#     设 `always` 会因 registry 上没有该 sha tag 而**必然报错**：Head .../manifests/…: EOF）。
PULL_POLICY=missing

# 编辑限速：每分钟处理多少个种子（按种子计，不是按请求计）
EDIT_RATE_PER_MIN=10
