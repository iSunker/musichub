data.db
data.db-journal
data.db-wal
data.db-shm
*.db
*.db-journal
*.db-wal
*.db-shm

# daemon 调度状态与心跳
daemon_state.json
daemon_heartbeat

# 生成的种子文件
output_torrents/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

