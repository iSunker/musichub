# ==================== 密钥与敏感配置 ====================
# .env 含站点 Cookie、qB 密码、图床 API Key，绝不能进仓库
.env
.env.*
!.env.example

# ==================== 运行时状态与产物 ====================
# SQLite 库（含种子记录、发布状态、站点 ID）
data.db
data.db-journal
data.db-wal
data.db-shm
*.db
*.db-journal
*.db-wal
*.db-shm

# daemon 调度状态与心跳
daemon_state.json
daemon_heartbeat

# 生成的种子文件
output_torrents/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# deploy.sh 的本地配置与备份
# .deploy.nasrc 含本机专用的 NAS 路径（各人机器不同），不进仓库
.deploy.nasrc
.deploy-backup/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
.DS_Store

# ==================== doc-audit 的投影产物与基线快照 ====================
# out/            = 可反复生成的派生数据（会漂）—— 进 git 就成了一条会漂的"事实"
# out.baseline-*/ = 一次测量的快照（会过期）—— 进 git 就从"某天的读数"升级成"事实源"
# 两种都不该进。判据与用法见 tools/doc-audit/INDEX-USAGE.md。
tools/doc-audit/out/
tools/doc-audit/out.baseline-*/
