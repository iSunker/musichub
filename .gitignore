# ==================== 密钥与敏感配置 ====================
# .env 含站点 Cookie、qB 密码、图床 API Key，绝不能进仓库
.env
.env.*
!.env.example

# ==================== 运行时状态与产物 ====================
# SQLite 库（含种子记录、发布状态、站点 ID）
data.db
data.db-journal
data.db-wal
data.db-shm
*.db
*.db-journal
*.db-wal
*.db-shm

# daemon 调度状态与心跳
daemon_state.json
daemon_heartbeat

# 生成的种子文件
output_torrents/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# deploy.sh 的本地配置与备份
# .deploy.nasrc 含本机专用的 NAS 路径（各人机器不同），不进仓库
.deploy.nasrc
.deploy-backup/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
.DS_Store

# ==================== doc-audit 的投影产物与基线快照 ====================
# out/            = 可反复生成的派生数据（会漂）—— 进 git 就成了一条会漂的"事实"
# out.baseline-*/ = 一次测量的快照（会过期）—— 进 git 就从"某天的读数"升级成"事实源"
# 两种都不该进。判据与用法见 tools/doc-audit/INDEX-USAGE.md。
tools/doc-audit/out/
tools/doc-audit/out.baseline-*/

# ==================== OpenCD 抓取产物与页面样本 ====================
# ★ 为什么默认忽略（2026-09-19 实测）：从皇后下载的**详情页 HTML 里带真凭据** ——
#   实测两份样本各有 2 处 passkey（download.php?id=…&passkey=<32位十六进制>），
#   另有登录用户名与魔力值。与 .env 同级的泄露面，绝不能进仓库。
#   见 README「安全」：凭据住在哪。
# ★ 注意不能写成「忽略整个目录 + !反忽略某文件」：git **不会进入被忽略的目录**，
#   那条反忽略**永远不生效**（本项目的 mdwalk.py 就是为这类"静默失效"而生的）。
#   所以：忽略目录、只反忽略脱敏后的样本 —— 脱敏样本放 opencdhtml/sanitized/。
raw_html/
opencdhtml/*
!opencdhtml/sanitized/

# ==================== 参考用的第三方仓库（只读参考，不是本项目的代码）====================
# repos/ 下五个独立 clone（各带自己的 .git，合计 33MB）：auto_feed_js / AutoSeed /
# easy-upload / Pt-Autoseed / PT-Plugin-Plus。
# ★ 它们**只用于读实现**（尤其 auto_feed_js 的 OpenCD 字段抽取、
#   easy-upload 的禁转关键词表），**不是本项目的代码** ——
#   提交它们等于把别人的源码与提交历史塞进本仓库，且将来会无意义地膨胀。
repos/

# 本地页面预览（tools/fetch_page.py 的产物）
_preview/

# ★ 容器内生效开关的快照（daemon.save_env_snapshot() 每轮写）。
#   它是**运行时产物**、不是事实源：进版本库会让"某天的开关"升级成"事实"，
#   而且本机那份会跟 NAS 上的真值漂开（同 tools/.nas_health_last.json 的理由）。
daemon_env.json

# ★★ tools/nas_health.py 的读数快照（--json 写）。
#   2026-09-24 才补：上面那条纪律**早就把本文件当反面教材引用**，
#   但**从没忽略它自己** —— 它一直被 git 跟踪（`git ls-files` 认它），
#   于是"某天的心跳/条数读数"真的被提交成了"事实"：
#   实测旧提交里躺着 heartbeat_alive=false / published=8，
#   而那是**跑脚本那一刻**的瞬间值，不是任何结论。
#   ★ 教训：写"X 的理由"时，要顺手确认 X 本身也被这条规则覆盖到 ——
#     否则引用得越准，越像"已经处理过了"。
#   ★ 与 tools/.baseline-*.json 同类（会变的读数），处置一致：不进仓库。
tools/.nas_health_last.json

# 一次性/判据留档（会变的数字与生产标题，不进仓库）
tools/.baseline-*.json
opencd_tid_backfill.json
